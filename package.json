{
  "name": "dsh-mobile-route-priority",
  "version": "0.3.1",
  "description": "Route priority controller for dsh-mobile-plugin: LAN-first, quality/stability auto picking, drag-to-reorder manual links, a self-healing watchdog, and an auto-restart guard that stops the repeated \"restart DSH\" loop caused by hot-loaded mobile-plugin updates.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "restart-helper.mjs",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "mobile",
    "route",
    "priority",
    "latency",
    "tailscale",
    "lan",
    "failover"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsit27/dsh-mobile-route-priority.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
