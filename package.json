{
  "name": "dsh-mobile-route-priority",
  "version": "0.1.0",
  "description": "Route priority controller for dsh-mobile-plugin: LAN-first, automatic quality picking, and a manual order with latency-threshold failover between Wi-Fi, Tailscale and the built-in tunnel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "mobile",
    "route",
    "priority",
    "latency",
    "tailscale",
    "lan",
    "failover"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsit27/dsh-mobile-route-priority.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
